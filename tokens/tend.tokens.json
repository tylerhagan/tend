{
  "$description": "Tend design tokens. The single source for src/styles/tokens.css and tokens/figma-variables.json (both generated by scripts/build-tokens.mjs; never edit those by hand). Calm and domestic: a sage-tinted paper ground, green-black ink, and one warm 'sun' accent that only marks what Tend does on the household's behalf.",
  "color": {
    "primitive": {
      "paper-50":  { "$type": "color", "$value": "#f6f7f3" },
      "paper-100": { "$type": "color", "$value": "#eef0ea" },
      "paper-200": { "$type": "color", "$value": "#e1e5dc" },
      "paper-300": { "$type": "color", "$value": "#b6bdae" },
      "ink-500":   { "$type": "color", "$value": "#565e54" },
      "ink-700":   { "$type": "color", "$value": "#3b423a" },
      "ink-900":   { "$type": "color", "$value": "#1c211c" },
      "night-900": { "$type": "color", "$value": "#141814" },
      "night-800": { "$type": "color", "$value": "#1c211c" },
      "night-700": { "$type": "color", "$value": "#262c26" },
      "night-600": { "$type": "color", "$value": "#454d45" },
      "night-300": { "$type": "color", "$value": "#9aa397" },
      "night-100": { "$type": "color", "$value": "#e8ebe4" },
      "sun-100":   { "$type": "color", "$value": "#f8e9cf" },
      "sun-400":   { "$type": "color", "$value": "#e7a93e" },
      "sun-600":   { "$type": "color", "$value": "#8a5413" },
      "sun-900":   { "$type": "color", "$value": "#3a2a12" },
      "leaf-600":  { "$type": "color", "$value": "#366d45" },
      "leaf-300":  { "$type": "color", "$value": "#8fc39b" },
      "clay-600":  { "$type": "color", "$value": "#a7452d" },
      "clay-300":  { "$type": "color", "$value": "#e79a84" },
      "clay-100":  { "$type": "color", "$value": "#f6e1da" },
      "clay-900":  { "$type": "color", "$value": "#3a1d16" }
    },
    "semantic": {
      "bg":          { "$type": "color", "$value": { "light": "{color.primitive.paper-100}", "dark": "{color.primitive.night-900}" } },
      "surface":     { "$type": "color", "$value": { "light": "{color.primitive.paper-50}",  "dark": "{color.primitive.night-800}" } },
      "surface-2":   { "$type": "color", "$value": { "light": "{color.primitive.paper-200}", "dark": "{color.primitive.night-700}" } },
      "line":        { "$type": "color", "$value": { "light": "{color.primitive.paper-300}", "dark": "{color.primitive.night-600}" } },
      "text":        { "$type": "color", "$value": { "light": "{color.primitive.ink-900}",   "dark": "{color.primitive.night-100}" } },
      "text-2":      { "$type": "color", "$value": { "light": "{color.primitive.ink-500}",   "dark": "{color.primitive.night-300}" } },
      "action":      { "$type": "color", "$value": { "light": "{color.primitive.ink-900}",   "dark": "{color.primitive.night-100}" }, "$description": "Buttons and controls: ink, not colour. The accent is reserved for Tend's own actions." },
      "action-text": { "$type": "color", "$value": { "light": "{color.primitive.paper-50}",  "dark": "{color.primitive.night-900}" } },
      "tend":        { "$type": "color", "$value": { "light": "{color.primitive.sun-600}",   "dark": "{color.primitive.sun-400}" }, "$description": "Marks something Tend did or will do for the household. Never decoration." },
      "tend-soft":   { "$type": "color", "$value": { "light": "{color.primitive.sun-100}",   "dark": "{color.primitive.sun-900}" } },
      "ok":          { "$type": "color", "$value": { "light": "{color.primitive.leaf-600}",  "dark": "{color.primitive.leaf-300}" } },
      "miss":        { "$type": "color", "$value": { "light": "{color.primitive.clay-600}",  "dark": "{color.primitive.clay-300}" } },
      "miss-soft":   { "$type": "color", "$value": { "light": "{color.primitive.clay-100}",  "dark": "{color.primitive.clay-900}" } }
    }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": "'Bricolage Grotesque', 'Segoe UI', system-ui, sans-serif" },
    "body":    { "$type": "fontFamily", "$value": "'Atkinson Hyperlegible', 'Segoe UI', system-ui, sans-serif", "$description": "Chosen for legibility at small sizes and for low vision (P5)." }
  },
  "size": {
    "text-xs":  { "$type": "dimension", "$value": "13px" },
    "text-sm":  { "$type": "dimension", "$value": "15px" },
    "text-md":  { "$type": "dimension", "$value": "17px", "$description": "Body. Larger than the usual 16px on purpose." },
    "text-lg":  { "$type": "dimension", "$value": "21px" },
    "text-xl":  { "$type": "dimension", "$value": "27px" },
    "text-2xl": { "$type": "dimension", "$value": "34px" },
    "target":   { "$type": "dimension", "$value": "48px", "$description": "Minimum tap target. Above WCAG 2.2 AA (24px) and platform guidance (44px)." }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "10px" },
    "md":   { "$type": "dimension", "$value": "18px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  }
}
